# === API 서버 ===
PORT=8788
LOG_LEVEL=info

# === LLM Providers (사용할 것만 채우면 됨 — provider 레지스트리가 DB/설정에서 라우팅) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# === Research (딥서치/웹서칭) ===
TAVILY_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# === 이미지 (스톡 사진 — 편집기 "스톡" 피커로 실사진 검색·삽입) ===
# 둘 중 하나만 채우면 됨(Pexels 우선, 없으면 Unsplash 폴백). 없으면 피커가 키 미설정 안내.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# === Postgres (P2에서 배선 — docker-compose가 로컬 인스턴스 제공) ===
# 로컬 개발 기본값(docker-compose.yml과 일치). 셀프호스트 시 외부 Postgres URL로 교체.
DATABASE_URL=postgresql://imppt:imppt_dev@localhost:5433/imppt

# === 워크스페이스 (단일 사용자 셀프호스트 기본; SaaS 멀티테넌트 아님) ===
WORKSPACE_ID=default
